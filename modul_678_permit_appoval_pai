using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Identity;
using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.RazorPages;
using PTW.JSEA.Application.Services;
using PTW.JSEA.Domain.Entities;
using PTW.JSEA.Domain.Interfaces.Repositories;

namespace PTW.JSEA.Web.Pages.Permits;

[Authorize(Roles = "HSEOfficer,AreaOwner,SystemAdmin,SafetyManager")]
public class PAIModel : PageModel
{
    private readonly IWorkPermitRepository _permitRepo;
    private readonly IFileStorageService _fileStorage;
    private readonly IAuditService _auditService;
    private readonly UserManager<ApplicationUser> _userManager;
    private readonly Infrastructure.Data.ApplicationDbContext _context;

    public PAIModel(
        IWorkPermitRepository permitRepo,
        IFileStorageService fileStorage,
        IAuditService auditService,
        UserManager<ApplicationUser> userManager,
        Infrastructure.Data.ApplicationDbContext context)
    {
        _permitRepo  = permitRepo;
        _fileStorage = fileStorage;
        _auditService= auditService;
        _userManager = userManager;
        _context     = context;
    }

    public WorkPermit Permit { get; set; } = null!;
    [BindProperty] public PAIInputModel Input { get; set; } = new();

    public class PAIInputModel
    {
        public bool AreaConditionSafe { get; set; }
        public bool FireExtinguisherAvailable { get; set; }
        public bool GasTestValid { get; set; }
        public bool PPEComplete { get; set; }
        public bool IsolationVerified { get; set; }
        public bool BarricadeInstalled { get; set; }
        public bool EmergencyExitClear { get; set; }
        public bool CommunicationReady { get; set; }
        public string? Notes { get; set; }
        public IFormFile? Photo1 { get; set; }
        public IFormFile? Photo2 { get; set; }
        public IFormFile? Photo3 { get; set; }
    }

    public async Task<IActionResult> OnGetAsync(int id)
    {
        var permit = await _permitRepo.GetWithDetailsAsync(id);
        if (permit == null) return NotFound();
        Permit = permit;
        return Page();
    }

    public async Task<IActionResult> OnPostAsync(int id)
    {
        var permit = await _permitRepo.GetByIdAsync(id);
        if (permit == null) return NotFound();
        Permit = (await _permitRepo.GetWithDetailsAsync(id))!;

        var user = await _userManager.GetUserAsync(User);
        var allowedImages = new[] { ".jpg", ".jpeg", ".png" };

        string? photo1Path = null, photo2Path = null, photo3Path = null;
        if (Input.Photo1 != null && _fileStorage.IsValidFile(Input.Photo1, allowedImages))
            photo1Path = await _fileStorage.SaveFileAsync(Input.Photo1, $"pai/{id}");
        if (Input.Photo2 != null && _fileStorage.IsValidFile(Input.Photo2, allowedImages))
            photo2Path = await _fileStorage.SaveFileAsync(Input.Photo2, $"pai/{id}");
        if (Input.Photo3 != null && _fileStorage.IsValidFile(Input.Photo3, allowedImages))
            photo3Path = await _fileStorage.SaveFileAsync(Input.Photo3, $"pai/{id}");

        var checklist = new PAIChecklist
        {
            PermitId                  = id,
            AreaConditionSafe         = Input.AreaConditionSafe,
            FireExtinguisherAvailable = Input.FireExtinguisherAvailable,
            GasTestValid              = Input.GasTestValid,
            PPEComplete               = Input.PPEComplete,
            IsolationVerified         = Input.IsolationVerified,
            BarricadeInstalled        = Input.BarricadeInstalled,
            EmergencyExitClear        = Input.EmergencyExitClear,
            CommunicationReady        = Input.CommunicationReady,
            Notes                     = Input.Notes,
            PhotoPath1                = photo1Path,
            PhotoPath2                = photo2Path,
            PhotoPath3                = photo3Path,
            InspectorId               = user!.Id,
            InspectorName             = user.FullName,
            InspectionDate            = DateTime.UtcNow,
            CreatedAt                 = DateTime.UtcNow
        };

        _context.PAIChecklists.Add(checklist);

        // Mark PAI completed on permit
        permit.PAICompleted   = true;
        permit.PAICompletedAt = DateTime.UtcNow;
        _context.WorkPermits.Update(permit);

        await _context.SaveChangesAsync();
        await _auditService.LogAsync("PAI", id, "PAICompleted", user.Id);

        TempData["Success"] = "PAI berhasil disimpan.";
        return RedirectToPage("/Permits/Detail", new { id });
    }
}
