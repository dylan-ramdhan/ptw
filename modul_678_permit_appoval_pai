using Microsoft.AspNetCore.Identity;
using PTW.JSEA.Domain.Entities;
using PTW.JSEA.Domain.Enums;
using PTW.JSEA.Domain.Interfaces.Repositories;
using PTW.JSEA.Infrastructure.Data;
using Microsoft.EntityFrameworkCore;

namespace PTW.JSEA.Application.Services;

public class WorkPermitService : IWorkPermitService
{
    private readonly IWorkPermitRepository _permitRepo;
    private readonly IUserRepository _userRepo;
    private readonly IAuditService _auditService;
    private readonly INotificationService _notificationService;
    private readonly ApplicationDbContext _context;
    private readonly UserManager<ApplicationUser> _userManager;
    private readonly IDashboardNotifier _dashboardNotifier;

    public WorkPermitService(
        IWorkPermitRepository permitRepo,
        IUserRepository userRepo,
        IAuditService auditService,
        INotificationService notificationService,
        ApplicationDbContext context,
        UserManager<ApplicationUser> userManager,
        IDashboardNotifier dashboardNotifier)
    {
        _permitRepo          = permitRepo;
        _userRepo            = userRepo;
        _auditService        = auditService;
        _notificationService = notificationService;
        _context             = context;
        _userManager         = userManager;
        _dashboardNotifier   = dashboardNotifier;
    }

    public async Task<WorkPermit> CreateAsync(WorkPermit permit, List<PermitWorker> workers, string requesterId)
    {
        permit.RequesterId  = requesterId;
        permit.Status       = PermitStatus.Draft;
        permit.PermitNumber = await GeneratePermitNumberAsync(permit.WorkType);
        permit.CreatedAt    = DateTime.UtcNow;
        permit.CreatedBy    = requesterId;
        permit.Workers      = workers;

        var created = await _permitRepo.AddAsync(permit);
        await _auditService.LogAsync("WorkPermit", created.Id, "Created", requesterId);
        return created;
    }

    public async Task<bool> SubmitAsync(int permitId, string userId)
    {
        var permit = await _permitRepo.GetByIdAsync(permitId);
        if (permit == null || permit.RequesterId != userId) return false;
        if (permit.Status != PermitStatus.Draft) return false;

        var old = permit.Status.ToString();
        permit.Status    = PermitStatus.Submitted;
        permit.UpdatedAt = DateTime.UtcNow;
        permit.UpdatedBy = userId;

        // Inisialisasi approval steps berdasarkan ApprovalMatrix
        await InitializeApprovalStepsAsync(permit);

        await _permitRepo.UpdateAsync(permit);
        await _auditService.LogAsync("WorkPermit", permitId, "Submitted", userId, old, "Submitted");

        // Notifikasi HSE Officer
        await _notificationService.SendPermitForApprovalNotificationAsync(permit);

        // Advance ke WaitingHSEReview
        permit.Status = PermitStatus.WaitingHSEReview;
        await _permitRepo.UpdateAsync(permit);

        return true;
    }

    public async Task<bool> ApproveStepAsync(int permitId, string approverId, string comments)
    {
        var permit = await _context.WorkPermits
            .Include(p => p.Approvals.OrderBy(a => a.Sequence))
            .Include(p => p.Requester)
            .FirstOrDefaultAsync(p => p.Id == permitId);

        if (permit == null) return false;

        // Cek eligibility
        var eligible = await CheckApproverEligibilityAsync(approverId, permitId);
        if (!eligible) throw new InvalidOperationException("Approver tidak memiliki sertifikasi valid untuk jenis pekerjaan ini.");

        // Cek role approver cocok dengan step saat ini
        var nextStep = permit.Approvals.FirstOrDefault(a => a.Status == ApprovalStatus.Pending);
        if (nextStep == null) return false;

        var approver = await _userManager.FindByIdAsync(approverId);
        if (approver == null) return false;
        var approverRoles = await _userManager.GetRolesAsync(approver);

        if (!approverRoles.Contains(nextStep.RequiredRole) &&
            !approverRoles.Contains("SystemAdmin")) return false;

        // Set approval
        nextStep.ApproverId  = approverId;
        nextStep.Status      = ApprovalStatus.Approved;
        nextStep.ApprovedAt  = DateTime.UtcNow;
        nextStep.Comments    = comments;
        nextStep.DigitalSignatureHash = GenerateSignatureHash(approverId, permitId, DateTime.UtcNow);

        // Cek apakah masih ada step berikutnya
        var nextPending = permit.Approvals
            .Where(a => a.Status == ApprovalStatus.Pending && a.Sequence > nextStep.Sequence)
            .OrderBy(a => a.Sequence)
            .FirstOrDefault();

        var oldStatus = permit.Status.ToString();

        if (nextPending != null)
        {
            // Advance ke step berikutnya
            permit.Status = nextPending.RequiredRole switch
            {
                "HSEOfficer"  => PermitStatus.WaitingHSEReview,
                "AreaOwner"   => PermitStatus.WaitingAreaApproval,
                "Approver"    => PermitStatus.WaitingFinalApproval,
                _             => PermitStatus.WaitingFinalApproval
            };
        }
        else
        {
            // Semua step selesai → Active
            permit.Status = PermitStatus.Active;
        }

        permit.UpdatedAt = DateTime.UtcNow;
        permit.UpdatedBy = approverId;

        await _context.SaveChangesAsync();
        await _auditService.LogAsync("WorkPermit", permitId, $"ApprovedStep:{nextStep.Sequence}", approverId, oldStatus, permit.Status.ToString(), comments);

        if (permit.Status == PermitStatus.Active)
        {
            await _notificationService.SendPermitApprovedNotificationAsync(permit);
            await _dashboardNotifier.NotifyPermitStatusChanged(permitId, "Active");
        }
        else
        {
            // Notifikasi ke approver role berikutnya
            if (nextPending != null)
                await _notificationService.CreateInAppForRoleAsync(
                    nextPending.RequiredRole,
                    "Permit Menunggu Approval Anda",
                    $"Permit {permit.PermitNumber} menunggu approval {nextPending.RequiredRole}.",
                    NotificationType.NewPermitForApproval,
                    $"/Permits/Detail/{permitId}");
        }

        return true;
    }

    public async Task<bool> RejectAsync(int permitId, string approverId, string reason)
    {
        var permit = await _permitRepo.GetWithDetailsAsync(permitId);
        if (permit == null) return false;

        var old = permit.Status.ToString();

        // Reject pending step
        var pendingStep = permit.Approvals.FirstOrDefault(a => a.Status == ApprovalStatus.Pending);
        if (pendingStep != null)
        {
            pendingStep.Status          = ApprovalStatus.Rejected;
            pendingStep.ApproverId      = approverId;
            pendingStep.ApprovedAt      = DateTime.UtcNow;
            pendingStep.RejectionReason = reason;
        }

        permit.Status    = PermitStatus.Rejected;
        permit.UpdatedAt = DateTime.UtcNow;
        permit.UpdatedBy = approverId;

        await _context.SaveChangesAsync();
        await _auditService.LogAsync("WorkPermit", permitId, "Rejected", approverId, old, "Rejected", reason);
        await _notificationService.SendPermitRejectedNotificationAsync(permit, reason);
        await _dashboardNotifier.NotifyPermitStatusChanged(permitId, "Rejected");

        return true;
    }

    public async Task<bool> SuspendAsync(int permitId, string userId, string reason)
    {
        var permit = await _permitRepo.GetByIdAsync(permitId);
        if (permit == null || permit.Status != PermitStatus.Active) return false;

        var old = permit.Status.ToString();
        permit.Status       = PermitStatus.Suspended;
        permit.SuspendReason= reason;
        permit.SuspendedAt  = DateTime.UtcNow;
        permit.SuspendedById= userId;
        permit.UpdatedAt    = DateTime.UtcNow;
        permit.UpdatedBy    = userId;

        await _permitRepo.UpdateAsync(permit);
        await _auditService.LogAsync("WorkPermit", permitId, "Suspended", userId, old, "Suspended", reason);
        await _dashboardNotifier.NotifyPermitStatusChanged(permitId, "Suspended");

        return true;
    }

    public async Task<bool> ResumeAsync(int permitId, string userId)
    {
        var permit = await _permitRepo.GetByIdAsync(permitId);
        if (permit == null || permit.Status != PermitStatus.Suspended) return false;

        var old = permit.Status.ToString();
        permit.Status     = PermitStatus.Active;
        permit.ResumedAt  = DateTime.UtcNow;
        permit.UpdatedAt  = DateTime.UtcNow;
        permit.UpdatedBy  = userId;

        await _permitRepo.UpdateAsync(permit);
        await _auditService.LogAsync("WorkPermit", permitId, "Resumed", userId, old, "Active");
        await _dashboardNotifier.NotifyPermitStatusChanged(permitId, "Active");

        return true;
    }

    public async Task<bool> CloseAsync(int permitId, string userId, string reason)
    {
        var permit = await _permitRepo.GetByIdAsync(permitId);
        if (permit == null) return false;
        if (permit.Status != PermitStatus.Active && permit.Status != PermitStatus.Suspended) return false;

        var old = permit.Status.ToString();
        permit.Status      = PermitStatus.Closed;
        permit.CloseReason = reason;
        permit.ClosedAt    = DateTime.UtcNow;
        permit.ClosedById  = userId;
        permit.UpdatedAt   = DateTime.UtcNow;
        permit.UpdatedBy   = userId;

        // Check-out semua worker yang masih check-in
        var workers = await _context.PermitWorkers.Where(w => w.PermitId == permitId && w.CheckInTime.HasValue && !w.CheckOutTime.HasValue).ToListAsync();
        foreach (var w in workers) w.CheckOutTime = DateTime.UtcNow;

        await _context.SaveChangesAsync();
        await _auditService.LogAsync("WorkPermit", permitId, "Closed", userId, old, "Closed", reason);
        await _dashboardNotifier.NotifyPermitStatusChanged(permitId, "Closed");

        return true;
    }

    public async Task<bool> EmergencyStopAsync(int permitId, string userId, string reason)
    {
        var success = await SuspendAsync(permitId, userId, $"[EMERGENCY STOP] {reason}");
        if (success)
        {
            var permit = await _permitRepo.GetByIdAsync(permitId);
            if (permit != null)
                await _dashboardNotifier.NotifyEmergencyStop(permitId, permit.Location, reason);
        }
        return success;
    }

    public async Task<string> GeneratePermitNumberAsync(WorkType workType)
    {
        var prefix = workType switch
        {
            WorkType.HotWork            => "HW",
            WorkType.ColdWork           => "CW",
            WorkType.ElectricalIsolation=> "EI",
            WorkType.ConfinedSpaceEntry => "CS",
            WorkType.Excavation         => "EX",
            WorkType.Lifting            => "LF",
            WorkType.WorkingAtHeight    => "WH",
            _                           => "WP"
        };
        var date = DateTime.Now.ToString("yyyyMMdd");
        var seq  = await _permitRepo.GetTodaySequenceAsync(workType) + 1;
        return $"MTL-{prefix}-{date}-{seq:D3}";
    }

    public async Task<bool> CheckApproverEligibilityAsync(string approverId, int permitId)
    {
        var permit = await _permitRepo.GetByIdAsync(permitId);
        if (permit == null) return false;
        return await _userRepo.HasValidCertificateAsync(approverId, permit.WorkType);
    }

    public async Task InitializeApprovalStepsAsync(WorkPermit permit)
    {
        var matrices = await _context.ApprovalMatrices
            .Where(m => m.WorkType == permit.WorkType
                     && m.RiskLevel == permit.RiskLevel
                     && m.IsActive)
            .OrderBy(m => m.Sequence)
            .ToListAsync();

        var approvals = matrices.Select(m => new PermitApproval
        {
            PermitId     = permit.Id,
            RequiredRole = m.RequiredRole,
            Sequence     = m.Sequence,
            Status       = ApprovalStatus.Pending,
            CreatedAt    = DateTime.UtcNow
        }).ToList();

        _context.PermitApprovals.AddRange(approvals);
    }

    private static string GenerateSignatureHash(string userId, int permitId, DateTime timestamp)
        => Convert.ToBase64String(
            System.Security.Cryptography.SHA256.HashData(
                System.Text.Encoding.UTF8.GetBytes($"{userId}:{permitId}:{timestamp:O}")));
}
