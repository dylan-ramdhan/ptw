using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Identity;
using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.RazorPages;
using PTW.JSEA.Domain.Entities;
using PTW.JSEA.Domain.Interfaces.Repositories;
using PTW.JSEA.Infrastructure.Data;

namespace PTW.JSEA.Web.Pages.Permits;

[Authorize]
public class AdherenceModel : PageModel
{
    private readonly IWorkPermitRepository _permitRepo;
    private readonly UserManager<ApplicationUser> _userManager;
    private readonly ApplicationDbContext _context;

    public AdherenceModel(
        IWorkPermitRepository permitRepo,
        UserManager<ApplicationUser> userManager,
        ApplicationDbContext context)
    {
        _permitRepo  = permitRepo;
        _userManager = userManager;
        _context     = context;
    }

    public WorkPermit Permit { get; set; } = null!;
    [BindProperty] public AdherenceInputModel Input { get; set; } = new();

    public class AdherenceInputModel
    {
        public bool IsCompliant { get; set; }
        public string? UnsafeObservation { get; set; }
        public string? CorrectiveAction { get; set; }
        public string? Notes { get; set; }
    }

    public async Task<IActionResult> OnGetAsync(int id)
    {
        var permit = await _permitRepo.GetWithDetailsAsync(id);
        if (permit == null) return NotFound();
        Permit = permit;
        return Page();
    }

    public async Task<IActionResult> OnPostAsync(int id)
    {
        var permit = await _permitRepo.GetByIdAsync(id);
        if (permit == null) return NotFound();
        Permit = (await _permitRepo.GetWithDetailsAsync(id))!;

        var user = await _userManager.GetUserAsync(User);
        var log  = new AdherenceLog
        {
            PermitId           = id,
            CheckTime          = DateTime.UtcNow,
            ObserverName       = user!.FullName,
            ObserverId         = user.Id,
            IsCompliant        = Input.IsCompliant,
            UnsafeObservation  = Input.UnsafeObservation,
            CorrectiveAction   = Input.CorrectiveAction,
            Notes              = Input.Notes,
            CreatedAt          = DateTime.UtcNow
        };

        _context.AdherenceLogs.Add(log);
        await _context.SaveChangesAsync();

        TempData["Success"] = "Log adherence berhasil disimpan.";
        return RedirectToPage("/Permits/Detail", new { id });
    }
}
