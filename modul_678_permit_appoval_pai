using System.Text.Json;

namespace PTW.JSEA.Web.Pages.Permits;

[Authorize(Roles = "Requester,SystemAdmin,HSEOfficer,SafetyManager")]
public class CreateModel : PageModel
{
    private readonly IWorkPermitService _permitService;
    private readonly ApplicationDbContext _context;
    private readonly UserManager<ApplicationUser> _userManager;

    public CreateModel(
        IWorkPermitService permitService,
        ApplicationDbContext context,
        UserManager<ApplicationUser> userManager)
    {
        _permitService = permitService;
        _context       = context;
        _userManager   = userManager;
    }

    [BindProperty] public PermitInputModel Input { get; set; } = new();
    [BindProperty] public string WorkersJson { get; set; } = "[]";

    public List<SelectListItem> JSEAOptions { get; set; } = new();

    public class PermitInputModel
    {
        public int JSEAId { get; set; }
        public string Location { get; set; } = string.Empty;
        public string? SpecificArea { get; set; }
        public WorkType WorkType { get; set; }
        public RiskLevel RiskLevel { get; set; }
        public DateTime StartTime { get; set; } = DateTime.Now.AddHours(1);
        public DateTime EndTime { get; set; } = DateTime.Now.AddHours(9);
        public string? Description { get; set; }
    }

    public async Task OnGetAsync()
    {
        var user = await _userManager.GetUserAsync(User);
        await LoadJSEAOptionsAsync(user!.Id);
    }

    public async Task<IActionResult> OnPostAsync()
    {
        var user = await _userManager.GetUserAsync(User);
        await LoadJSEAOptionsAsync(user!.Id);

        if (!ModelState.IsValid) return Page();

        // Parse workers
        List<PermitWorker> workers = new();
        try
        {
            var raw = JsonSerializer.Deserialize<List<WorkerInput>>(WorkersJson,
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            workers = raw?.Select(w => new PermitWorker
            {
                WorkerName    = w.WorkerName,
                Company       = w.Company,
                Position      = w.Position,
                FitnessStatus = true
            }).ToList() ?? new();
        }
        catch { }

        var permit = new WorkPermit
        {
            JSEAId      = Input.JSEAId,
            Location    = Input.Location,
            SpecificArea= Input.SpecificArea,
            WorkType    = Input.WorkType,
            RiskLevel   = Input.RiskLevel,
            StartTime   = Input.StartTime.ToUniversalTime(),
            EndTime     = Input.EndTime.ToUniversalTime(),
            Description = Input.Description
        };

        var created = await _permitService.CreateAsync(permit, workers, user!.Id);
        TempData["Success"] = $"Permit {created.PermitNumber} berhasil dibuat.";
        return RedirectToPage("/Permits/Detail", new { id = created.Id });
    }

    private async Task LoadJSEAOptionsAsync(string userId)
    {
        var jseas = await _context.JSEAs
            .Where(j => j.Status == JSEAStatus.Approved && !j.IsDeleted)
            .Select(j => new { j.Id, j.WorkTitle, j.WorkType, j.Location })
            .ToListAsync();

        JSEAOptions = jseas.Select(j => new SelectListItem
        {
            Value = j.Id.ToString(),
            Text  = $"{j.WorkTitle} ({j.WorkType}) — {j.Location}"
        }).ToList();
    }

    public class WorkerInput
    {
        public string WorkerName { get; set; } = string.Empty;
        public string? Company { get; set; }
        public string? Position { get; set; }
    }
}
