using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Identity;
using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.RazorPages;
using PTW.JSEA.Application.Services;
using PTW.JSEA.Domain.Entities;
using PTW.JSEA.Domain.Enums;
using PTW.JSEA.Domain.Interfaces.Repositories;

namespace PTW.JSEA.Web.Pages.Permits;

[Authorize]
public class DetailModel : PageModel
{
    private readonly IWorkPermitRepository _permitRepo;
    private readonly IWorkPermitService _permitService;
    private readonly IUserRepository _userRepo;
    private readonly UserManager<ApplicationUser> _userManager;

    public DetailModel(
        IWorkPermitRepository permitRepo,
        IWorkPermitService permitService,
        IUserRepository userRepo,
        UserManager<ApplicationUser> userManager)
    {
        _permitRepo    = permitRepo;
        _permitService = permitService;
        _userRepo      = userRepo;
        _userManager   = userManager;
    }

    public WorkPermit Permit { get; set; } = null!;
    public bool CanSubmit      { get; set; }
    public bool CanApprove     { get; set; }
    public bool CanReject      { get; set; }
    public bool CanSuspend     { get; set; }
    public bool CanResume      { get; set; }
    public bool CanClose       { get; set; }
    public bool CanEmergencyStop { get; set; }
    public bool IsApproverEligible { get; set; }
    public PermitApproval? CurrentApprovalStep { get; set; }

    [BindProperty] public string? ApprovalComments  { get; set; }
    [BindProperty] public string? RejectionReason   { get; set; }
    [BindProperty] public string? SuspendReason     { get; set; }
    [BindProperty] public string? CloseReason       { get; set; }

    public async Task<IActionResult> OnGetAsync(int id)
    {
        var permit = await _permitRepo.GetWithDetailsAsync(id);
        if (permit == null) return NotFound();
        Permit = permit;

        var user  = await _userManager.GetUserAsync(User);
        var roles = await _userManager.GetRolesAsync(user!);

        CurrentApprovalStep = permit.Approvals
            .Where(a => a.Status == ApprovalStatus.Pending)
            .OrderBy(a => a.Sequence)
            .FirstOrDefault();

        // Eligibility check
        if (CurrentApprovalStep != null && roles.Contains(CurrentApprovalStep.RequiredRole))
            IsApproverEligible = await _permitService.CheckApproverEligibilityAsync(user!.Id, id);

        CanSubmit        = permit.RequesterId == user!.Id && permit.Status == PermitStatus.Draft;
        CanApprove       = IsApproverEligible && CurrentApprovalStep != null &&
                          roles.Contains(CurrentApprovalStep?.RequiredRole ?? "");
        CanReject        = CanApprove;
        CanSuspend       = permit.Status == PermitStatus.Active &&
                          roles.Any(r => r is "HSEOfficer" or "SafetyManager" or "SystemAdmin" or "AreaOwner");
        CanResume        = permit.Status == PermitStatus.Suspended &&
                          roles.Any(r => r is "HSEOfficer" or "SafetyManager" or "SystemAdmin");
        CanClose         = (permit.Status == PermitStatus.Active || permit.Status == PermitStatus.Suspended) &&
                          (permit.RequesterId == user!.Id || roles.Any(r => r is "HSEOfficer" or "SafetyManager" or "SystemAdmin"));
        CanEmergencyStop = permit.Status == PermitStatus.Active &&
                          roles.Any(r => r is "HSEOfficer" or "SafetyManager" or "SystemAdmin" or "AreaOwner");

        if (TempData["Success"] != null) ViewData["Success"] = TempData["Success"];
        if (TempData["Error"] != null)   ViewData["Error"]   = TempData["Error"];
        return Page();
    }

    public async Task<IActionResult> OnPostSubmitAsync(int id)
    {
        var user = await _userManager.GetUserAsync(User);
        var ok   = await _permitService.SubmitAsync(id, user!.Id);
        TempData[ok ? "Success" : "Error"] = ok ? "Permit berhasil disubmit." : "Gagal submit permit.";
        return RedirectToPage(new { id });
    }

    public async Task<IActionResult> OnPostApproveAsync(int id)
    {
        var user = await _userManager.GetUserAsync(User);
        try
        {
            var ok = await _permitService.ApproveStepAsync(id, user!.Id, ApprovalComments ?? "");
            TempData[ok ? "Success" : "Error"] = ok ? "Permit berhasil di-approve." : "Gagal approve permit.";
        }
        catch (InvalidOperationException ex)
        {
            TempData["Error"] = ex.Message;
        }
        return RedirectToPage(new { id });
    }

    public async Task<IActionResult> OnPostRejectAsync(int id)
    {
        var user = await _userManager.GetUserAsync(User);
        var ok   = await _permitService.RejectAsync(id, user!.Id, RejectionReason ?? "-");
        TempData[ok ? "Success" : "Error"] = ok ? "Permit ditolak." : "Gagal menolak permit.";
        return RedirectToPage(new { id });
    }

    public async Task<IActionResult> OnPostSuspendAsync(int id)
    {
        var user = await _userManager.GetUserAsync(User);
        var ok   = await _permitService.SuspendAsync(id, user!.Id, SuspendReason ?? "-");
        TempData[ok ? "Success" : "Error"] = ok ? "Permit disuspend." : "Gagal suspend permit.";
        return RedirectToPage(new { id });
    }

    public async Task<IActionResult> OnPostResumeAsync(int id)
    {
        var user = await _userManager.GetUserAsync(User);
        var ok   = await _permitService.ResumeAsync(id, user!.Id);
        TempData[ok ? "Success" : "Error"] = ok ? "Permit diaktifkan kembali." : "Gagal resume permit.";
        return RedirectToPage(new { id });
    }

    public async Task<IActionResult> OnPostCloseAsync(int id)
    {
        var user = await _userManager.GetUserAsync(User);
        var ok   = await _permitService.CloseAsync(id, user!.Id, CloseReason ?? "Pekerjaan selesai.");
        TempData[ok ? "Success" : "Error"] = ok ? "Permit ditutup." : "Gagal menutup permit.";
        return RedirectToPage(new { id });
    }

    public async Task<IActionResult> OnPostEmergencyStopAsync(int id)
    {
        var user = await _userManager.GetUserAsync(User);
        await _permitService.EmergencyStopAsync(id, user!.Id, SuspendReason ?? "Emergency stop");
        TempData["Success"] = "Emergency stop berhasil. Semua pihak telah diberitahu.";
        return RedirectToPage(new { id });
    }
