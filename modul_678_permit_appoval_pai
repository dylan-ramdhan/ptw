using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Identity;
using Microsoft.AspNetCore.Mvc.RazorPages;
using Microsoft.EntityFrameworkCore;
using PTW.JSEA.Domain.Entities;
using PTW.JSEA.Domain.Enums;
using PTW.JSEA.Infrastructure.Data;

namespace PTW.JSEA.Web.Pages.Permits;

[Authorize(Roles = "HSEOfficer,AreaOwner,Approver,SafetyManager,SystemAdmin")]
public class MyApprovalsModel : PageModel
{
    private readonly ApplicationDbContext _context;
    private readonly UserManager<ApplicationUser> _userManager;

    public MyApprovalsModel(ApplicationDbContext context, UserManager<ApplicationUser> userManager)
    {
        _context     = context;
        _userManager = userManager;
    }

    public List<ApprovalQueueDto> Queue { get; set; } = new();

    public async Task OnGetAsync()
    {
        var user  = await _userManager.GetUserAsync(User);
        var roles = await _userManager.GetRolesAsync(user!);

        // Tampilkan permit yang menunggu approval sesuai role user
        var pendingPermits = await _context.WorkPermits
            .Include(p => p.Requester)
            .Include(p => p.Approvals)
            .Include(p => p.JSEA)
            .Where(p => p.Approvals.Any(a =>
                a.Status == ApprovalStatus.Pending &&
                roles.Contains(a.RequiredRole)))
            .Where(p => p.Status != PermitStatus.Draft &&
                        p.Status != PermitStatus.Active &&
                        p.Status != PermitStatus.Closed &&
                        p.Status != PermitStatus.Rejected)
            .OrderBy(p => p.CreatedAt)
            .ToListAsync();

        Queue = pendingPermits.Select(p =>
        {
            var myStep = p.Approvals
                .Where(a => a.Status == ApprovalStatus.Pending && roles.Contains(a.RequiredRole))
                .OrderBy(a => a.Sequence)
                .FirstOrDefault();
            return new ApprovalQueueDto
            {
                PermitId      = p.Id,
                PermitNumber  = p.PermitNumber,
                WorkType      = p.WorkType.ToString(),
                Location      = p.Location,
                RiskLevel     = p.RiskLevel.ToString(),
                RequesterName = p.Requester?.FullName ?? "-",
                SubmittedAt   = p.UpdatedAt ?? p.CreatedAt,
                ApprovalStep  = myStep?.RequiredRole ?? "",
                Sequence      = myStep?.Sequence ?? 0
            };
        }).ToList();
    }

    public class ApprovalQueueDto
    {
        public int PermitId { get; set; }
        public string PermitNumber { get; set; } = string.Empty;
        public string WorkType { get; set; } = string.Empty;
        public string Location { get; set; } = string.Empty;
        public string RiskLevel { get; set; } = string.Empty;
        public string RequesterName { get; set; } = string.Empty;
        public DateTime SubmittedAt { get; set; }
        public string ApprovalStep { get; set; } = string.Empty;
        public int Sequence { get; set; }
    }
}
