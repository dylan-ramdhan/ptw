using System.Security.Claims;
using Microsoft.AspNetCore.Identity;
using PTW.JSEA.Application.DTOs;
using PTW.JSEA.Domain.Entities;
using PTW.JSEA.Domain.Enums;
using PTW.JSEA.Domain.Interfaces.Repositories;

namespace PTW.JSEA.Application.Services;

public class DashboardService : IDashboardService
{
    private readonly IWorkPermitRepository _permitRepo;
    private readonly IGenericRepository<AdherenceLog> _adherenceRepo;
    private readonly IGenericRepository<PermitApproval> _approvalRepo;
    private readonly IGenericRepository<AuditLog> _auditRepo;
    private readonly INotificationService _notificationService;
    private readonly UserManager<ApplicationUser> _userManager;

    public DashboardService(
        IWorkPermitRepository permitRepo,
        IGenericRepository<AdherenceLog> adherenceRepo,
        IGenericRepository<PermitApproval> approvalRepo,
        IGenericRepository<AuditLog> auditRepo,
        INotificationService notificationService,
        UserManager<ApplicationUser> userManager)
    {
        _permitRepo = permitRepo;
        _adherenceRepo = adherenceRepo;
        _approvalRepo = approvalRepo;
        _auditRepo = auditRepo;
        _notificationService = notificationService;
        _userManager = userManager;
    }

    public async Task<DashboardStatsDto> GetDashboardStatsAsync(ClaimsPrincipal userPrincipal)
    {
        var userId = _userManager.GetUserId(userPrincipal) ?? string.Empty;

        var activePermits = (await _permitRepo.GetActivePermitsAsync()).ToList();

        // Overdue adherence: permit aktif yang tidak ada adherence log > 4 jam
        var adherenceThreshold = DateTime.UtcNow.AddHours(-4);
        var overdueCount = 0;
        foreach (var p in activePermits)
        {
            var lastLog = (await _adherenceRepo.FindAsync(a => a.PermitId == p.Id))
                .OrderByDescending(a => a.CheckTime).FirstOrDefault();
            if (lastLog == null || lastLog.CheckTime < adherenceThreshold)
                overdueCount++;
        }

        // Pending approvals untuk user ini
        var pendingApprovals = await _approvalRepo.CountAsync(a =>
            a.Status == ApprovalStatus.Pending);

        // Unread notifications
        var unreadCount = await _notificationService.GetUnreadCountAsync(userId);

        // Recent activities
        var recentLogs = (await _auditRepo.GetAllAsync())
            .OrderByDescending(x => x.ActionDate)
            .Take(10)
            .Select(x => new RecentActivityDto
            {
                Timestamp = x.ActionDate,
                Description = $"{x.Action} — {x.Module} #{x.EntityId}",
                Module = x.Module,
                ActionBy = x.ActionBy
            }).ToList();

        return new DashboardStatsDto
        {
            ActivePermitCount = activePermits.Count,
            HighRiskPermitCount = await _permitRepo.GetHighRiskCountAsync(),
            ActiveWorkerCount = activePermits.Sum(p => p.Workers.Count(w => w.CheckInTime.HasValue && !w.CheckOutTime.HasValue)),
            OverdueAdherenceCount = overdueCount,
            PendingApprovalCount = pendingApprovals,
            UnreadNotificationCount = unreadCount,
            ActivePermits = activePermits.Select(p => new ActivePermitDto
            {
                Id = p.Id,
                PermitNumber = p.PermitNumber,
                WorkType = p.WorkType.ToString(),
                Location = p.Location,
                RequesterName = p.Requester?.FullName ?? "-",
                WorkerCount = p.Workers.Count,
                EndTime = p.EndTime,
                RiskLevel = p.RiskLevel.ToString(),
                IsExpiringSoon = p.IsExpiringSoon
            }).ToList(),
            RecentActivities = recentLogs
        };
    }
