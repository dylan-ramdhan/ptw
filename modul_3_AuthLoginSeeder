```javascript
// ─── SignalR Connection ────────────────────────────────────────────────────
let connection;

function initSignalR() {
    connection = new signalR.HubConnectionBuilder()
        .withUrl("/hubs/permit")
        .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
        .configureLogging(signalR.LogLevel.Warning)
        .build();

    // Event handlers
    connection.on("PermitStatusChanged", (data) => {
        const badge = document.getElementById(`permit-status-${data.permitId}`);
        if (badge) badge.textContent = data.newStatus;
        showToast(`Permit #${data.permitId}: Status berubah ke ${data.newStatus}`, 'info');
    });

    connection.on("CounterUpdated", (data) => {
        const el = document.getElementById("active-permits-count");
        const wl = document.getElementById("active-workers-count");
        if (el) el.textContent = data.activePermits;
        if (wl) wl.textContent = data.activeWorkers;
    });

    connection.on("EmergencyStop", (data) => {
        showToast(`🚨 EMERGENCY STOP — ${data.location}: ${data.reason}`, 'emergency', 10000);
        // Tampilkan modal jika ada
        const modal = document.getElementById('emergencyModal');
        if (modal) {
            document.getElementById('emergencyLocation').textContent = data.location;
            document.getElementById('emergencyReason').textContent = data.reason;
            modal.classList.remove('hidden');
        }
    });

    connection.on("AdherenceOverdue", (data) => {
        showToast(`⚠️ Adherence overdue: Permit ${data.permitNumber}`, 'warning');
    });

    connection.on("NewNotification", (data) => {
        loadNotifCount();
        showToast(data.title, 'info');
    });

    connection.onreconnecting(() => console.log('SignalR reconnecting...'));
    connection.onreconnected(() => {
        console.log('SignalR reconnected');
        connection.invoke("JoinDashboardGroup").catch(console.error);
    });

    connection.start()
        .then(() => {
            console.log('SignalR connected');
            connection.invoke("JoinDashboardGroup").catch(console.error);
        })
        .catch(err => console.error('SignalR error:', err));
}

// Init SignalR bila user logged in
