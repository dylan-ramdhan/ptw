using Microsoft.AspNetCore.Identity;
using PTW.JSEA.Domain.Entities;
using PTW.JSEA.Domain.Enums;
using PTW.JSEA.Domain.Interfaces.Repositories;

namespace PTW.JSEA.Application.Services;

public class NotificationService : INotificationService
{
    private readonly IGenericRepository<Notification> _notifRepo;
    private readonly IUserRepository _userRepo;
    private readonly UserManager<ApplicationUser> _userManager;

    public NotificationService(
        IGenericRepository<Notification> notifRepo,
        IUserRepository userRepo,
        UserManager<ApplicationUser> userManager)
    {
        _notifRepo = notifRepo;
        _userRepo = userRepo;
        _userManager = userManager;
    }

    public async Task CreateInAppAsync(string userId, string title, string message,
        NotificationType type, string? link = null)
    {
        var notif = new Notification
        {
            UserId = userId,
            Title = title,
            Message = message,
            Type = type,
            Link = link,
            IsRead = false,
            CreatedAt = DateTime.UtcNow
        };
        await _notifRepo.AddAsync(notif);
    }

    public async Task CreateInAppForRoleAsync(string role, string title, string message,
        NotificationType type, string? link = null)
    {
        var users = await _userRepo.GetByRoleAsync(role);
        foreach (var user in users)
            await CreateInAppAsync(user.Id, title, message, type, link);
    }

    public async Task<IEnumerable<Notification>> GetUnreadAsync(string userId)
        => await _notifRepo.FindAsync(x => x.UserId == userId && !x.IsRead);

    public async Task<int> GetUnreadCountAsync(string userId)
        => await _notifRepo.CountAsync(x => x.UserId == userId && !x.IsRead);

    public async Task MarkAsReadAsync(int notificationId, string userId)
    {
        var notif = await _notifRepo.GetByIdAsync(notificationId);
        if (notif != null && notif.UserId == userId)
        {
            notif.IsRead = true;
            notif.ReadAt = DateTime.UtcNow;
            await _notifRepo.UpdateAsync(notif);
        }
    }

    public async Task MarkAllAsReadAsync(string userId)
    {
        var unread = await _notifRepo.FindAsync(x => x.UserId == userId && !x.IsRead);
        foreach (var n in unread)
        {
            n.IsRead = true;
            n.ReadAt = DateTime.UtcNow;
            await _notifRepo.UpdateAsync(n);
        }
    }

    public async Task SendPermitApprovedNotificationAsync(WorkPermit permit)
    {
        await CreateInAppAsync(
            permit.RequesterId,
            "Permit Disetujui",
            $"Permit {permit.PermitNumber} telah disetujui dan sekarang aktif.",
            NotificationType.PermitApproved,
            $"/Permits/Detail/{permit.Id}");
    }

    public async Task SendPermitRejectedNotificationAsync(WorkPermit permit, string reason)
    {
        await CreateInAppAsync(
            permit.RequesterId,
            "Permit Ditolak",
            $"Permit {permit.PermitNumber} ditolak. Alasan: {reason}",
            NotificationType.PermitRejected,
            $"/Permits/Detail/{permit.Id}");
    }

    public async Task SendPermitForApprovalNotificationAsync(WorkPermit permit)
    {
        // Kirim ke HSE Officer untuk review pertama
        await CreateInAppForRoleAsync(
            "HSEOfficer",
            "Permit Baru Menunggu Review",
            $"Permit {permit.PermitNumber} ({permit.WorkType}) di {permit.Location} menunggu review HSE.",
            NotificationType.NewPermitForApproval,
            $"/Permits/Detail/{permit.Id}");
    }
}
